[Unit]
Description=Industrial AI Next.js web reader
After=network-online.target postgresql@18-industrial_ai.service
Wants=network-online.target
Requires=postgresql@18-industrial_ai.service

[Service]
Type=simple
User=industrial-web
Group=industrial-ai
WorkingDirectory=/srv/industrial-ai/current
EnvironmentFile=/etc/industrial-ai/web.env
ExecStartPre=/srv/industrial-ai/venv/bin/python deploy/linux/preflight.py web
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start apps/web --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/industrial-ai/current/apps/web/.next/cache
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=industrial-ai-web

[Install]
WantedBy=multi-user.target
