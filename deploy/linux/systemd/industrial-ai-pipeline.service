[Unit]
Description=Industrial AI daily pipeline (safe dry-run default)
After=network-online.target postgresql@18-industrial_ai.service
Wants=network-online.target
Requires=postgresql@18-industrial_ai.service

[Service]
Type=oneshot
User=industrial-worker
Group=industrial-ai
WorkingDirectory=/srv/industrial-ai/current
EnvironmentFile=/etc/industrial-ai/worker.env
ExecStartPre=/srv/industrial-ai/venv/bin/python deploy/linux/preflight.py worker
ExecStart=/srv/industrial-ai/venv/bin/python -m services.pipeline.daily tick --dry-run --resume --report /var/lib/industrial-ai/artifacts/daily-status.json
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/industrial-ai/artifacts
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=industrial-ai-pipeline
