DATA_MODE=database
DATABASE_URL=postgresql://digest:digest@localhost:5432/digest
SITE_URL=http://localhost:3000
# DATA_MODE=fixture explicitly enables synthetic demonstrations only.
# OPENAI_API_KEY is required for live editorial generation. Configure securely.
OPENAI_MODEL=gpt-6.1-terra
OPENAI_CLASSIFY_MODEL=gpt-6-luna
OPENAI_VERIFY_MODEL=gpt-6.1-terra
OPENAI_REASONING_EFFORT=low
